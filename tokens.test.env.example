# Dev-only secrets. Copy to tokens.test.env on the CPU pod (mode 600).
# Never commit the filled file. Isolation rewrites tokens.env from this file
# and deletes any live key that has no replacement here.
#
# cp tokens.test.env.example tokens.test.env
# chmod 600 tokens.test.env

PASTOR_ENV=development
CPU_ONLY=1
VLLM_MODE=serverless

# Stripe test mode only. Leave blank to disable billing on dev.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
PUBLIC_APP_URL=

# Dev serverless GPU endpoints. Must not be the production GPU pod.
RUNPOD_API_KEY=
RUNPOD_VLLM_ENDPOINT_ID=
RUNPOD_WHISPER_ENDPOINT_ID=

# Required. Isolation aborts when this is empty or admin123.
DJANGO_SUPERUSER_PASSWORD=

# Optional. Isolation generates these once into tokens.test.env when blank.
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=

# Google sign-in client whose authorized origins are the dev tunnel only.
GOOGLE_CLIENT_ID=

# Sandbox mailbox. Gmail/SMTP stay off unless the sender is in this list.
GMAIL_SANDBOX_SENDERS=
GMAIL_SENDER=

# Leave blank to disable. A production audience id is refused.
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=

# Leave blank to skip the production Vimeo folder.
VIMEO_ACCESS_TOKEN=
VIMEO_FOLDER_ID=
VIMEO_USER_ID=

# Read-only Hugging Face token for the dev worker. HF_TOKEN_SCOPE=write is refused.
HF_TOKEN=
HF_TOKEN_SCOPE=read
