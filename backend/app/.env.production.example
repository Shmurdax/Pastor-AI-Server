SERVER_NAME=api.yourdomain.com

DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace_with_long_random_secret
DJANGO_ALLOWED_HOSTS=api.yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.yourdomain.com
DJANGO_CORS_ALLOW_ALL_ORIGINS=false
DJANGO_CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_REFERRER_POLICY=strict-origin-when-cross-origin
DRF_THROTTLE_ANON=30/minute
DRF_THROTTLE_USER=120/minute
PUBLIC_API_KEY=replace_with_long_random_api_key
SESSION_SCOPE_SALT=replace_with_long_random_salt

POSTGRES_DB=ai_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=replace_with_strong_password

# Django admin (/admin/) — ensured on container start
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin123
DJANGO_SUPERUSER_EMAIL=admin@localhost

HUGGING_FACE_HUB_TOKEN=replace_with_your_hf_token
VLLM_URL=http://vllm:8000/v1

ADMIN_INGESTION_MOUNT_PATH=/var/www/pastor_ai/PDF-Data
HOST_UID=1000
HOST_GID=1000
HOST_USER=student
HOST_HOME=/tmp

# Existing optional mount override if needed:
# FRONTEND_MOUNT_PATH=../../Pastor-AI-Server-front_end_backup
