# Copy to config.env and fill in your Hugging Face token.
#   cp config.env.example config.env
#   nano config.env

# Required — read access to your private LoRA on the Hub
HF_TOKEN=hf_your_token_here

# Fine-tuned LoRA repo (default is apophaticai private model)
CHRISTIANAI_HF_REPO=apophaticai/qwen2.5-14b-christianai-v1

# Persistent workspace root on RunPod network volume
WORKSPACE_ROOT=/workspace/pastor-ai

# Public tunnel: cloudflared (recommended) or ngrok
TUNNEL=cloudflared

# Optional — only if TUNNEL=ngrok (may be blocked on some home networks)
NGROK_AUTH_TOKEN=
NGROK_DOMAIN=
