# Copy to config.env (install.sh also generates this). Do not commit secrets.

# Git channel this host tracks. All new work lands on `development`.
# Production (christian-ai-prd) should use `master`.
# PASTOR_GIT_BRANCH=development
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
DJANGO_CORS_ALLOW_ALL_ORIGINS=true
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false

# Private Django admin path (NOT /admin/ — that URL now 404s). Share only with staff.
DJANGO_ADMIN_URL=rB4zKwO2wTBCD3pAxRIdTWsvw0w8
# Django admin login — created automatically on install/start
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin123
DJANGO_SUPERUSER_EMAIL=admin@localhost

POSTGRES_DB=ai_db
POSTGRES_USER=pastor
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Hugging Face — required for private Christian LoRA + gated models
HF_TOKEN=hf_paste_here
HUGGING_FACE_HUB_TOKEN=hf_paste_here
HF_HOME=/workspace/pastor-ai/hf_cache
HF_HUB_ENABLE_HF_TRANSFER=0

# Inference: Qwen2.5-14B-Instruct-AWQ + Christian LoRA (served as christianai)
# Local GPU pod (default):
VLLM_URL=http://127.0.0.1:8010/v1
VLLM_MODE=local
# CPU web/db pod + RunPod Serverless vLLM:
# VLLM_MODE=serverless
# CPU_ONLY=1
# RUNPOD_VLLM_ENDPOINT_ID=your_endpoint_id
# RUNPOD_API_KEY=rpa_...
# VLLM_URL=https://api.runpod.ai/v2/your_endpoint_id/openai/v1
VLLM_MODEL=christianai
VLLM_PORT=8010
VLLM_MAX_MODEL_LEN=32768
# start.sh caps this at 0.80 on a full GPU so one shared sermon-search
# process can load the same BGE embedder and reranker. 24GB MIG stays lower
# for Whisper. Set SEARCH_GPU=0 to keep search on CPU and leave this at 0.90.
# SEARCH_GPU=auto
# SEARCH_SIDECAR_PORT=8012
VLLM_GPU_MEM_UTIL=0.90
CHRISTIANAI_HF_REPO=apophaticai/qwen2.5-14b-christianai-v1
CHRISTIANAI_LORA_DIR=/workspace/pastor-ai/christianai-lora
CHRISTIANAI_BASE_VLLM=Qwen/Qwen2.5-14B-Instruct-AWQ
CHRISTIANAI_SERVED_NAME=christianai

QDRANT_URL=http://127.0.0.1:6333
QDRANT_BIN=/workspace/bin/qdrant
QDRANT_STORAGE=/workspace/pastor-ai/qdrant_storage
QDRANT_COLLECTION=sermon_brain
QDRANT_VECTOR_SIZE=768
EMBEDDING_MODEL_NAME=BAAI/bge-base-en-v1.5
EMBEDDING_DEVICE=cpu
# Cross-encoder rerank of ~40 ANN+catalog windows. Same model and shortlist
# on CPU pods and on the GPU search sidecar. Does not reingest Qdrant.
# Fail-open to ANN scores if the model is missing.
RERANK_ENABLED=1
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_CANDIDATES=40
RERANK_MAX_CHARS=1024
RERANK_DEVICE=cpu

# Durable sermon PDFs + Postgres dump (outside the git tree so install.sh rsync cannot wipe them)
INGESTION_UPLOAD_DIR=/workspace/persistent/uploads/admin_ingestion
VIDEO_INGESTION_UPLOAD_DIR=/workspace/persistent/uploads/admin_video_ingestion
WHISPER_MODEL=base
WHISPER_DEVICE=auto
# CPU web pod: keep ffmpeg/DB local and send audio to a Faster-Whisper GPU worker.
# WHISPER_MODE=serverless
# RUNPOD_WHISPER_ENDPOINT_ID=your_whisper_endpoint_id
WHISPER_CACHE_DIR=/workspace/persistent/whisper
PERSIST_ROOT=/workspace/persistent
PERSIST_PG_DUMP=/workspace/persistent/postgres/ai_db.dump

FRONTEND_BUILD_DIR=/workspace/pastor-ai/frontend

TUNNEL=cloudflared
# Named Cloudflare tunnel token is stored in .cloudflared/tunnel.token and
# mirrored to $PERSIST_ROOT/.cloudflared/tunnel.token on start/apply-tokens.
# CLOUDFLARE_TUNNEL_TOKEN=
# Leave empty so the Flutter web UI can call /api/chat/ without a key
PUBLIC_API_KEY=

# Chat generation budget (must fit vLLM --max-model-len)
# Target ~2000-character mixed-prose replies and keep about 5–10 prior turns.
# Qwen2.5-14B AWQ on 48GB serverless supports the model's native 32768 window
# when MAX_NUM_SEQS stays low (default 256 would OOM). Django caps this to
# VLLM_MAX_MODEL_LEN so prompts cannot overflow the worker.
CHAT_MAX_HISTORY_CHARS=20000
CHAT_MAX_HISTORY_TURNS=10
CHAT_MAX_CONTEXT_CHARS=40000
CHAT_MAX_TOKENS=1024
CHAT_CONTEXT_WINDOW=32768
VLLM_MAX_MODEL_LEN=32768
RETRIEVAL_K=24
RETRIEVAL_THRESHOLD=0.8
RETRIEVAL_CANDIDATE_MULTIPLIER=8
RETRIEVAL_MAX_PER_SOURCE=4
RETRIEVAL_MAX_PER_BIBLE_BOOK=2
RETRIEVAL_BIBLE_RATIO=0.40
RETRIEVAL_VIDEO_RATIO=0.45
RETRIEVAL_SOURCE_MIN=3
RETRIEVAL_SOURCE_MAX=5
INGEST_CHUNK_SIZE=1800
INGEST_CHUNK_OVERLAP=250
# Points per Qdrant upsert. One REST body cannot exceed 32MiB (~8k NKJV verses
# is ~153MB as a single upsert). Default 128 stays well under that cap.
INGEST_QDRANT_UPSERT_BATCH=128
CHAT_TIMEOUT_S=360
# Video topic metadata (1=use vLLM when available; 0=heuristic only)
VIDEO_TOPIC_METADATA_LLM=1

# Google Sign-In web client ID (Django verifies ID tokens from Flutter;
# also exposed to the web UI via GET /api/auth/config/)
GOOGLE_CLIENT_ID=

# Gmail API — send 6-digit verification codes through Google (not SMTP).
# Option A (Workspace): service account JSON + domain-wide delegation for gmail.send
# Option B: OAuth client secret + refresh token with gmail.send
GMAIL_SENDER=info@thenordins.org
GMAIL_SERVICE_ACCOUNT_FILE=/workspace/pastor-ai/secrets/gmail-sender.json
GMAIL_SERVICE_ACCOUNT_JSON=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Stripe Premium subscriptions (Embedded Checkout)
# Get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional — create Products/Prices in Stripe Dashboard; leave blank to use $15/$150 defaults
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# Public site URL used for Checkout return_url (tunnel or custom domain)
PUBLIC_APP_URL=

# Stripe Checkout shows a required subscription-acknowledgment checkbox when a
# Terms of Service URL is set in Dashboard → Settings → Public details.
# Example: https://your-domain/subscription-terms/

# TEMPORARY mock checkout (gifts Premium, no charges). Auto-on when Stripe keys
# are empty. Set to false once real Stripe credentials are configured.
BILLING_MOCK_CHECKOUT=

# Mailchimp audience export (Django admin → existing Mailchimp list)
# API key: Mailchimp → Account → Extras → API keys (ends with a datacenter, e.g. -us21)
# Audience ID: Audience → Settings → Audience name and defaults
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=

# Transactional email for post-signup verification codes.
# Leave EMAIL_HOST empty to log messages to the console (local/dev).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL="Nordin's AI <info@thenordins.org>"
