# RunPod Serverless Faster-Whisper (video ingest GPU)
#
# Separate from the vLLM chat endpoint so a 14B model does not occupy VRAM
# during sermon transcription. Deploy from:
#   https://console.runpod.io/hub/runpod-workers/worker-faster_whisper
#
# GPU: 8–16GB is enough for Whisper `base` / `small` (T4, L4, A4000).
# Active workers 0, max workers 1, idle timeout 60–120s, execution timeout 600s.
#
# The CPU web pod extracts audio with ffmpeg and POSTs compressed mp3 to:
#   https://api.runpod.ai/v2/<ENDPOINT_ID>/runsync
#
# Request `model` is sent by Pastor-AI (WHISPER_MODEL, default base).

# Optional: pin a default model on the worker. Pastor-AI overrides per request.
MODEL_NAME=base
