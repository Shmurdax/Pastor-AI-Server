# RunPod Serverless vLLM worker (Qwen2.5-14B AWQ + Christian LoRA)
#
# Fastest path — create both GPU endpoints from the API:
#   export RUNPOD_API_KEY=rpa_... HF_TOKEN=hf_...
#   bash serverless/create_runpod_endpoints.sh --write-tokens
#
# Or paste these into the endpoint's Environment Variables in the RunPod console.
# Deploy from the Hub: https://console.runpod.io/hub/runpod-workers/worker-vllm
# Docs: https://docs.runpod.io/serverless/vllm/environment-variables
#
# GPU: 48GB Ampere/Ada (A40 / A6000 / L40S / 6000 Ada). 14B AWQ + LoRA
# OOMs on 24GB. Exclude ADA_48_PRO's Blackwell MIG 2g.48gb slices —
# worker-v1-vllm CUDA 12 cannot start on them.
#
# Do not attach a user network volume for chat — that pins one DC and
# workers sit THROTTLED waiting for 48GB cards. Host-cached MODEL_NAME at
# /runpod-volume/huggingface-cache is faster. Set HF_TOKEN as a RunPod
# secret (private LoRA). Do NOT reuse the CPU pod volume in US-NE-1.

MODEL_NAME=Qwen/Qwen2.5-14B-Instruct-AWQ
MAX_MODEL_LEN=8192
GPU_MEMORY_UTILIZATION=0.90
TRUST_REMOTE_CODE=1
QUANTIZATION=awq
ENABLE_LORA=true
MAX_LORAS=1
MAX_LORA_RANK=16
LORA_MODULES={"name":"christianai","path":"apophaticai/qwen2.5-14b-christianai-v1"}
OPENAI_SERVED_MODEL_NAME_OVERRIDE=christianai
RAW_OPENAI_OUTPUT=1
HF_TOKEN=hf_paste_here

# Official vLLM workers load RunPod's host-side cached MODEL_NAME from
# /runpod-volume/huggingface-cache. Do not attach a user network volume for
# chat: that pin to one DC throttles workers and is slower than host cache.
DOWNLOAD_DIR=/runpod-volume/huggingface-cache
HF_HOME=/runpod-volume/huggingface-cache
VLLM_CACHE_ROOT=/runpod-volume/vllm_cache
ENFORCE_EAGER=true
DISABLE_LOG_STATS=1
DISABLE_LOG_REQUESTS=1
