# =============================================================================
# Pastor-AI secrets — copy to tokens.env, paste your values, then run:
#   bash /workspace/pastor-ai/apply-tokens.sh
#
#   cp tokens.env.example tokens.env
#   nano tokens.env
#   bash apply-tokens.sh
# =============================================================================

# Hugging Face (required for private/gated models on a local GPU pod;
# on a CPU web pod this is optional — set HF_TOKEN on the serverless endpoint instead)
HF_TOKEN=hf_paste_here
HUGGING_FACE_HUB_TOKEN=hf_paste_here

# GitHub (for pushing install scripts / repo updates)
GITHUB_TOKEN=ghp_paste_here
GITHUB_USER=GavWrecker
GITHUB_REPO=GavWrecker/Pastor-AI-Server

# Ngrok (optional — only if TUNNEL=ngrok)
NGROK_AUTH_TOKEN=paste_ngrok_authtoken_here
NGROK_DOMAIN=intimiste-qualified-emeline.ngrok-free.dev

# Tunnel: cloudflared (default) or ngrok
TUNNEL=cloudflared

# Google Sign-In (OAuth 2.0 Web client ID — must match Flutter --dart-define)
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Stripe Premium (Embedded Checkout) — paste test/live keys from dashboard.stripe.com
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Optional Price IDs (otherwise server uses $15/mo and $150/yr price_data):
# STRIPE_PRICE_MONTHLY=price_...
# STRIPE_PRICE_YEARLY=price_...
# PUBLIC_APP_URL=https://your-public-domain
# TEMPORARY — production stays off unless you explicitly set true (DEBUG-only auto-mock):
# BILLING_MOCK_CHECKOUT=false

# Vimeo Daily Devotionals (Folder auto-sync)
# Create a token with public + private scopes. Folder URL looks like:
#   https://vimeo.com/user/21759939/folder/24205069
# VIMEO_ACCESS_TOKEN=your_vimeo_access_token
# VIMEO_FOLDER_ID=24205069
# VIMEO_USER_ID=21759939
# VIMEO_FREE_PREVIEW_ID=987654321

# RunPod Serverless GPUs (CPU web/db pod). Create both endpoints with:
#   bash serverless/create_runpod_endpoints.sh --write-tokens
# Endpoint IDs are serverless endpoints, not GPU pod ids.
# API key: https://www.runpod.io/console/user/settings
# CPU_ONLY=1
# VLLM_MODE=serverless
# RUNPOD_VLLM_ENDPOINT_ID=your_vllm_endpoint_id
# RUNPOD_API_KEY=rpa_your_runpod_api_key
# Optional override if you already have the full OpenAI base URL:
# VLLM_URL=https://api.runpod.ai/v2/your_vllm_endpoint_id/openai/v1
#
# RunPod Serverless Whisper (GPU ingest; keep this off the vLLM worker).
# WHISPER_MODE=serverless
# RUNPOD_WHISPER_ENDPOINT_ID=your_whisper_endpoint_id
# Optional: WHISPER_API_KEY=...   # defaults to RUNPOD_API_KEY
#
# Do not set these for chat unless you pass --attach-volume (slower / THROTTLED).
# RUNPOD_NETWORK_VOLUME_ID=
# RUNPOD_DATA_CENTER_IDS=

# Optional overrides (leave blank to keep generated values in config.env)
# DJANGO_SECRET_KEY=
# DJANGO_DEBUG=false
# DJANGO_SUPERUSER_PASSWORD=
# POSTGRES_PASSWORD=
# PUBLIC_API_KEY=
